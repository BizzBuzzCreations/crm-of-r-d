{"nodes": [{"id": "crm_agencyos_notification_architecture_blueprint", "label": "Production-Grade Notification Architecture Blueprint", "file_type": "rationale", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explicitly marked NOT YET IMPLEMENTED: the current system is only Socket.io + MongoDB-persisted notifications with a simple notificationPrefs Map on User; this document is an aspirational future direction (web-push/VAPID, BullMQ-driven notification queue, NotificationPreference schema), not shipped behavior."}, {"id": "crm_agencyos_notification_architecture_notification_schema", "label": "Notification Mongoose Schema (proposed)", "file_type": "document", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_notification_architecture_notificationpreference_schema", "label": "NotificationPreference Schema (proposed)", "file_type": "document", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_notification_architecture_channel_socketio", "label": "Channel A: In-App Socket.io Delivery", "file_type": "concept", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_notification_architecture_channel_webpush", "label": "Channel B: Web Push Notifications (VAPID)", "file_type": "concept", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_notification_architecture_channel_email", "label": "Channel C: Email (SMTP / Transactional API)", "file_type": "concept", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_notification_architecture_bullmq_queueing", "label": "Redis + BullMQ Queueing for Notification Delivery", "file_type": "rationale", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Template rendering, SMTP connections, and push requests are block-heavy, so delivery is offloaded from the main Express server to a Redis/BullMQ queue and dedicated workers to keep API response times sub-100ms; BullMQ's exponential-backoff retries ensure no notification is lost if a delivery service is temporarily down."}, {"id": "crm_agencyos_notification_architecture_rate_limiting_aggregation", "label": "Rate Limiting & Digest Aggregation", "file_type": "rationale", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web Push and Email are throttled and bursts are aggregated into a single digest (e.g. 10 DMs in 1 minute while offline becomes one 'you have 10 unread messages' email) to prevent spam rather than sending one notification per event."}, {"id": "crm_agencyos_notification_architecture_trigger_routing_matrix", "label": "Trigger & Routing Matrix", "file_type": "document", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_backend_src_models_notification_notification", "label": "Notification Mongoose Model (current)", "file_type": "code", "source_file": "crm-agencyos/NOTIFICATION_ARCHITECTURE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contri