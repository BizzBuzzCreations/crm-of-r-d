{"nodes": [{"id": "crm_agencyos_claude_single_zustand_store", "label": "Single Zustand Store Pattern", "file_type": "rationale", "source_file": "crm-agencyos/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All frontend domain state (auth, users, messages/channels/DMs, tasks, todos, clients, leads, meetings, notifications, timer, UI state) lives in one ~1500-line store because these domains interact heavily (e.g. socket events must update multiple domains at once); it is called out as the most important file in the frontend."}, {"id": "crm_agencyos_claude_socket_lifecycle", "label": "Socket Lifecycle Management in Store", "file_type": "concept", "source_file": "crm-agencyos/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_claude_activethread_resolution", "label": "activeThread State Resolution", "file_type": "concept", "source_file": "crm-agencyos/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "crm_agencyos_claude_unread_count_persistence", "label": "Unread Count Persistence via localStorage", "file_type": "rationale", "source_file": "crm-agencyos/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unread counts are persisted in localStorage keyed crm_unread_{userId} so badge counts survive page reloads."}, {"id": "crm_agencyos_claude_timer_worklog_beacon_sync", "label": "Timer/Worklog Sync via sendBeacon", "file_type": "rationale", "source_file": "crm-agencyos/CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Timer/worklog state is synced to /api/worklog via navigator.sendBeacon() on beforeunload specifically so work time is not lost when a tab closes."}, {"id": "crm_agenc